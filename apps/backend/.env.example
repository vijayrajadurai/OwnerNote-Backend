# Database (PostgreSQL / Supabase-compatible)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shopai_dev"

# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"

# OTP
# Provider: "console" logs OTP to server logs (dev only).
# "firebase" = Android Firebase Phone Auth; backend verifies the ID token at POST /auth/firebase.
# "msg91" / "twilio" = server-sent SMS (legacy send-otp).
OTP_PROVIDER="console"
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Firebase Admin (required for POST /auth/firebase — the service account JSON
# you generated in Firebase Console → Project settings → Service accounts).
# Paste the whole JSON as one line, or use the three fields below instead.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=owner-note
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# MSG91 (optional, required if OTP_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# Twilio (optional, required if OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Test login — a fixed username/password login, entirely separate from
# the real phone+OTP flow, for testing the app before a real OTP
# provider is wired up. Off by default. NEVER enable this in production
# (env.ts refuses to boot if TEST_LOGIN_ENABLED=true and
# NODE_ENV=production) — remove/disable it again before a real launch.
TEST_LOGIN_ENABLED="false"
TEST_LOGIN_USERNAME=
TEST_LOGIN_PASSWORD=

# CORS
CORS_ORIGIN="*"

# Reverse proxy trust. Default "false" = trust no proxy (req.ip is always
# the raw socket address; any X-Forwarded-For header is ignored). In
# production, set this to the exact number of reverse-proxy hops in front
# of this server (e.g. "1" for a single load balancer/CDN) once the
# hosting topology is chosen — never "true", which would trust an
# unbounded forwarded-header chain.
TRUST_PROXY="false"
