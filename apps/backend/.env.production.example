# ==============================================================================
# NEWONX backend — PRODUCTION environment template
# ==============================================================================
#
# This file is a TEMPLATE, not a real config. Every value below is an
# obvious placeholder — copy this file to the real production secret
# store / hosting platform's environment settings, and replace every
# placeholder with a real value there. NEVER fill in real production
# values here and commit them. This file itself must stay tracked in git
# (it's documentation), but a filled-in ".env.production" must never be
# committed — see .gitignore.
#
# Every variable here is validated at backend boot time by
# apps/backend/src/config/env.ts. If NODE_ENV=production and any of the
# production-only rules below are violated, the process refuses to start
# and logs exactly which variable is wrong (without ever printing the
# actual secret value back).
#
# Variables are grouped to match env.ts, in the same order, each labeled
# REQUIRED or OPTIONAL for a production deployment.
# ==============================================================================


# ------------------------------------------------------------------------------
# Server
# ------------------------------------------------------------------------------

# REQUIRED. Must be exactly "production" — this is what turns on every
# production-only safety check below (rejecting console OTP, placeholder/
# weak JWT secrets, and CORS_ORIGIN="*"). Leaving this at its dev default
# ("development") would silently skip all of them.
NODE_ENV="production"

# OPTIONAL (default: 4000). Many hosting platforms (Render, Railway, Fly,
# Heroku, etc.) inject their own PORT and expect the app to listen on it —
# check your platform before hardcoding this.
PORT=4000


# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------

# REQUIRED. Must point to your real production PostgreSQL instance — never
# the local/dev database. Production Postgres should require TLS: append
# sslmode=require (standard Postgres connection strings) or your hosting
# platform's equivalent (e.g. many managed providers require or default to
# this already — confirm with your provider rather than assuming).
DATABASE_URL="postgresql://PRODUCTION_DB_USER:PRODUCTION_DB_PASSWORD@PRODUCTION_DB_HOST:5432/NEWONX?sslmode=require"


# ------------------------------------------------------------------------------
# Auth
# ------------------------------------------------------------------------------

# REQUIRED. Must be a unique, high-entropy secret generated specifically
# for this deployment — never reused from .env / .env.example / .env.test,
# and never committed to git. env.ts enforces, in production: at least 32
# characters, at least 8 distinct characters, and rejects the exact
# placeholder strings shipped in this repo's other .env* files. Generate
# one with, e.g.: openssl rand -base64 48
JWT_SECRET="GENERATE_A_RANDOM_32_PLUS_CHARACTER_SECRET"

# OPTIONAL (default: "30d"). How long an issued JWT stays valid. There is
# currently no server-side revocation, so a leaked token stays valid for
# this entire window — consider shortening this for production.
JWT_EXPIRES_IN="30d"


# ------------------------------------------------------------------------------
# OTP delivery
# ------------------------------------------------------------------------------

# REQUIRED. Must NOT be "console" in production — env.ts refuses to boot
# if it is, because the console provider prints OTP codes to the server
# log, which would let anyone with log access sign in as any user.
# Real supported values: "msg91" or "twilio". As of this codebase,
# only "msg91" is actually wired to a real API — the "twilio" provider
# class exists but currently always throws (it is not yet implemented
# against the real Twilio Verify API). Do not select "twilio" in
# production until that implementation is finished. Replace the
# placeholder below with whichever real, already-integrated provider you
# are actually using — do not invent a provider that isn't supported.
OTP_PROVIDER="YOUR_REAL_OTP_PROVIDER"

# OPTIONAL (default: 300). How long an OTP code stays valid, in seconds.
OTP_TTL_SECONDS=300

# OPTIONAL (default: 5). How many wrong-code attempts are allowed per OTP
# challenge before it's locked out.
OTP_MAX_ATTEMPTS=5

# REQUIRED only if OTP_PROVIDER="msg91" (the only currently-wired real
# provider). Leave unset/blank if using a different provider.
MSG91_AUTH_KEY="YOUR_MSG91_AUTH_KEY"
MSG91_TEMPLATE_ID="YOUR_MSG91_TEMPLATE_ID"
# OPTIONAL even when OTP_PROVIDER="msg91" — included in the request but not
# required by the application.
MSG91_SENDER_ID="YOUR_MSG91_SENDER_ID"

# OPTIONAL — only relevant if OTP_PROVIDER="twilio", and note the caveat
# above: the Twilio provider in this codebase is not yet wired to a real
# API call, so setting these alone does not make Twilio OTP delivery work.
TWILIO_ACCOUNT_SID="YOUR_TWILIO_ACCOUNT_SID"
TWILIO_AUTH_TOKEN="YOUR_TWILIO_AUTH_TOKEN"
TWILIO_VERIFY_SERVICE_SID="YOUR_TWILIO_VERIFY_SERVICE_SID"


# ------------------------------------------------------------------------------
# Test login
# ------------------------------------------------------------------------------

# MUST be "false" (or unset) in production — env.ts refuses to boot if
# TEST_LOGIN_ENABLED=true and NODE_ENV=production. This is a
# fixed-username/password login used only to test the app before a real
# OTP provider is wired up; it bypasses OTP entirely, so it must never be
# reachable in a real deployment.
TEST_LOGIN_ENABLED="false"
TEST_LOGIN_USERNAME=
TEST_LOGIN_PASSWORD=


# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------

# REQUIRED. Must be one or more explicit origins — env.ts refuses to boot
# if this is "*" (or contains "*" anywhere in a comma-separated list) when
# NODE_ENV=production. Set it to the real origin(s) that serve the NEWONX
# web dashboard (apps/web) once that domain is chosen — comma-separate
# multiple origins, no spaces needed around commas but trimmed either way:
#   CORS_ORIGIN="https://admin.example.com,https://another.example.com"
CORS_ORIGIN="https://YOUR_PRODUCTION_WEB_DOMAIN"


# ------------------------------------------------------------------------------
# Reverse proxy trust
# ------------------------------------------------------------------------------

# REQUIRED to set correctly for your real topology (has a safe default of
# "false", but almost every production deployment sits behind at least one
# reverse proxy/load balancer/CDN, and leaving this at "false" then means
# express-rate-limit sees every client as the proxy's single IP). Set it
# to the exact number of reverse-proxy hops directly in front of this
# server — e.g. "1" for a single load balancer. Never "true": env.ts
# rejects that value outright because it would trust an unbounded
# forwarded-header chain instead of a specific, known hop count. The
# example below assumes exactly one proxy; adjust to match your actual
# hosting topology once it is chosen.
TRUST_PROXY="1"
