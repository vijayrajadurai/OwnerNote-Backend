# apps/backend's own ignore rules for the backend image build.
#
# NOTE: this image is built with the monorepo ROOT as build context
# (docker build -f apps/backend/Dockerfile .), because the npm workspace
# lockfile lives at the repo root. Docker only reads a .dockerignore from
# the build context's own root, so the file that actually governs a real
# build is the root /.dockerignore, not this one — this file documents
# the same exclusions for apps/backend specifically (e.g. for anyone
# building with context=apps/backend instead) and is kept in sync with it.

node_modules
dist
coverage
tests
*.log
logs

.env
.env.*
!.env.example
!.env.production.example

.git
.gitignore
.vscode
.idea
.DS_Store
